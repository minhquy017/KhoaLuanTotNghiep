# Python Virtual Environments
.venv/
venv/
**/venv/
ENV/
env/

# Byte-compiled / optimized / DLL files
**/__pycache__/
*.py[cod]
*$py.class

# Backups and temporary files
*.bak
*.tmp
*.log

# Large Datasets & Processed SQLite Database (Lưu trữ trên Cloud / Google Drive)
data/raw/raw_dataset/
data/raw/*.bak
data/processed/*.db
data/processed/*.db-journal
data/processed/*.db-wal
data/processed/*.db-shm
data/processed/*.sqlite
data/processed/*.sqlite3
data/processed/chroma_db/
scratch/

# Crawler scraped JSON and backups (tránh lỗi vượt quá 100MB trên GitHub)
crawlers/**/*.json
crawlers/**/*.bak
crawlers/**/hotels/*.json
crawlers/**/restaurants/*.json
crawlers/**/attractions/*.json

# Giữ lại metadata địa điểm và từ điển ẩm thực mẫu
!data/raw/vietnam_places_metadata.json
!data/processed/culinary_gazetteer.json

# Operating System Files
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# IDE / Editor settings
.vscode/
.idea/
*.swp
*.swo

# Crawler temporary progress & raw dumps
data/raw/*_supplement.json*
data/raw/partial_*.json*
data/raw/progress_*.json*
data/raw/exhausted_*.json
crawlers/.chrome_data/

# Presentation slides and Word documents
*.pptx
*.docx
docs/*.docx
!docs/KHOA_LUAN_TOT_NGHIEP_TOAN_VAN.docx

# LaTeX compilation artifacts
thesis-latex/*.aux
thesis-latex/**/*.aux
thesis-latex/*.bbl
thesis-latex/*.blg
thesis-latex/*.lof
thesis-latex/*.lot
thesis-latex/*.out
thesis-latex/*.toc
thesis-latex/*.log
thesis-latex/*.synctex.gz

# Presentation figures & generation scripts
docs/figures/
scripts/generate_*.py
scripts/build_presentation.py
scripts/export_presentation_script_docx.py
.agents/
.ag-kit-backups/